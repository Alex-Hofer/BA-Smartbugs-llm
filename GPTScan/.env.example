# Vorlage fuer GPTScan/.env -- kopieren nach `GPTScan/.env` und ausfuellen.
# `.env` ist git-ignoriert (.gitignore Zeile 2-3) und wird per .dockerignore aus
# jedem Image ausgeschlossen. Diese Vorlage enthaelt niemals echte Werte.
#
# WARUM DIESE DATEI UNTER GPTScan/ LIEGT, OBWOHL SIE BEIDE WERKZEUGE BETRIFFT
# -----------------------------------------------------------------------------
# Alle vier Runner-Skripte im Repo-Wurzelverzeichnis lesen fest den Pfad
# `GPTScan\.env` (run_curated.ps1, run_full_v2.ps1, run_full_v2_llmsa.ps1,
# run_retry_llmsa.ps1). Die Vorlage muss deshalb neben der Datei liegen, die
# tatsaechlich gelesen wird. GPTScan selbst laedt
# sie zusaetzlich beim Start ueber python-dotenv (src/tasks.py:111).
#
# WAS DAVON WIRKLICH ANKOMMT
# -----------------------------------------------------------------------------
# Alle vier Runner laden JEDE Zuweisung dieser Datei in die Prozessumgebung und
# entfernen sie am Ende wieder. Anbieter und Modell bestimmen sie danach aus
# ihren Parametern (-Provider, -Model, -BaseUrl, -ContextTokens,
# -MaxCompletionTokens) und ueberschreiben damit, was hier fuer
# GPTSCAN_PROVIDER/GPTSCAN_MODEL bzw. LLM_PROVIDER/LLM_MODEL/LLM_CONTEXT_TOKENS
# steht. Diese Datei ist also der Ort fuer SCHLUESSEL; die Backend-Wahl gehoert
# an den Aufruf. Siehe README.md, Abschnitt "Modell wählen und wechseln".
#
# Welcher Schluessel gebraucht wird, haengt am Anbieter; fehlt er, bricht der
# Runner ab, bevor ein Container startet.
#
# Nur Variablen, die auf dem Host gesetzt sind, reicht SmartBugs in den
# Container durch -- die Allowlist steht im Feld `env:` der jeweiligen
# `smartbugs/tools/<werkzeug>/config.yaml`. Nichts davon steckt im Image.


# =============================================================================
# 1. API-Schluessel  (beide Werkzeuge)
# =============================================================================

# Schluessel fuer DeepSeek. PFLICHT bei Provider `deepseek` -- dem Standard aller
# vier Runner. Fehlt er dann, brechen sie ab, noch bevor ein Container startet.
# Gelesen von: GPTScan/src/config.py (PROVIDERS.deepseek.api_key_env) und
#              camel/model_backend.py ueber run.py, das ihn auf OPENAI_API_KEY legt.
DEEPSEEK_API_KEY=

# Schluessel fuer OpenAI. Nur noetig bei GPTSCAN_PROVIDER=openai bzw.
# LLM_PROVIDER=openai. Standard: leer. Fehlt er bei Provider `openai`, scheitert
# der erste Aufruf mit einer klaren Fehlermeldung (kein stiller Fallback).
OPENAI_API_KEY=


# =============================================================================
# 2. GPTScan  (Allowlist in smartbugs/tools/gptscan/config.yaml)
# =============================================================================

# Anbieter: deepseek | openai | custom.
# Standard ohne Angabe: deepseek -- zweifach, im Entrypoint
# (scripts/do_solidity.sh) und in GPTScan/src/config.py:DEFAULT_PROVIDER.
# Ein unbekannter Name fuehrt bewusst zum Abbruch statt zum Fallback, damit
# nicht unbemerkt ein anderes Backend abgerechnet wird
# (GPTScan/src/llm_backend.py:active_provider).
# Die Runner setzen sie aus ihrem Parameter -Provider; der Wert hier wirkt nur
# bei einem direkten `python -m sb`-Aufruf.
GPTSCAN_PROVIDER=deepseek

# Modell-ID, wird als `--model` an GPTScan durchgereicht.
# Standard ohne Angabe: der "cheap"-Tier des Anbieters, also
# deepseek-v4-flash bzw. gpt-3.5-turbo (GPTScan/src/config.py:PROVIDERS).
# Gelesen von: scripts/do_solidity.sh und llm_backend.py:model_override.
# Die Runner setzen sie aus -Model bzw. -GptscanModel.
GPTSCAN_MODEL=deepseek-v4-flash

# 1 = Trockenlauf: die Pipeline laeuft vollstaendig, setzt aber keinen einzigen
# API-Aufruf ab und schaetzt die Kosten nur. Standard: 0.
# Gelesen von: scripts/do_solidity.sh (-> --dry-run) und llm_backend.py:is_dry_run.
# Die Runner setzen sie ueber ihren Schalter -GptscanDry bzw. -Mode dry.
GPTSCAN_DRY_RUN=0

# OpenAI-kompatibler Endpunkt -- wird AUSSCHLIESSLICH bei
# GPTSCAN_PROVIDER=custom ausgewertet und sonst ignoriert. Die Einschraenkung
# ist Absicht: ein bezahltes Backend darf sich nicht per Umgebungsvariable
# umleiten lassen (GPTScan/src/llm_backend.py:base_url).
# Beispiel fuer den lokalen Pruefstand: http://host.docker.internal:8000/v1
# Standard: leer.
GPTSCAN_BASE_URL=

# Schluessel fuer GPTSCAN_PROVIDER=custom. Fuer deepseek und openai gelten
# stattdessen DEEPSEEK_API_KEY / OPENAI_API_KEY
# (GPTScan/src/config.py:PROVIDERS.custom.api_key_env). Standard: leer.
GPTSCAN_API_KEY=


# =============================================================================
# 3. LLMSmartAudit  (Allowlist in smartbugs/tools/llmsmartaudit/config.yaml)
# =============================================================================

# Anbieter: deepseek | openai. Standard ohne Angabe: deepseek
# (scripts/do_solidity.sh). Der Entrypoint exportiert den aufgeloesten Wert
# ausdruecklich weiter, damit der Zwischenstand nicht provider="unknown"
# meldet, waehrend der Endbericht "deepseek" sagt.
# Die Runner setzen sie aus ihrem Parameter -Provider.
LLM_PROVIDER=deepseek

# Modell-ID. PFLICHT -- nicht optional.
# Das Image traegt `deepseek-chat` als ENV eingebrannt; dieses Modell ist seit
# 24.07.2026 abgeschaltet, und der Name geht verbatim an die DeepSeek-API.
# Ohne diese Variable scheitert JEDER Lauf mit HTTP 400
# (docs/BA-DURCHFUEHRUNGSPROTOKOLL.md, Fehler #1). Der Wert wird als `--model`
# an run.py gereicht, das daraus intern LLM_MODEL_ID setzt; camel/model_backend.py
# schickt diese ID unveraendert an die API.
# Die Runner setzen sie aus -Model bzw. -LlmModel.
LLM_MODEL=deepseek-v4-flash

# OpenAI-kompatibler Endpunkt. Der Entrypoint exportiert ihn als BASE_URL;
# camel/model_backend.py:_resolve_endpoint liest ihn von dort.
# Standard ohne Angabe: run.py setzt fuer provider=deepseek
# https://api.deepseek.com, fuer openai den SDK-Standard.
# Die Runner setzen sie aus ihrem Parameter -BaseUrl.
LLM_BASE_URL=

# Groesse des Kontextfensters in Token, als Rueckfallwert fuer Modell-IDs, die
# camel/model_backend.py:num_max_token_map nicht kennt -- und deepseek-v4-flash
# kennt es nicht. Standard ohne Angabe: 16384
# (model_backend.py:DEFAULT_CONTEXT_TOKENS und camel/utils.py:138).
# Alle Laeufe dieser Arbeit setzen 65536. Das hebt die Agentengrenze nicht auf:
# auf grossen DeFi-Contracts brechen die Agenten trotzdem mit
# max_tokens_exceeded_by_camel ab (37 von 96 in llmsa_mwefixed_v2).
# Die Runner setzen sie aus ihrem Parameter -ContextTokens (Default 65536).
LLM_CONTEXT_TOKENS=65536

# Obergrenze fuer die Antwortlaenge je Aufruf. Wirkt als Minimum gegen den
# Wert, den das Werkzeug selbst berechnet
# (camel/model_backend.py:_cap_completion_tokens). Standard ohne Angabe: keine
# zusaetzliche Grenze; fuer deepseek-Modelle deckelt das Werkzeug ohnehin auf
# 8192, weil die API hoehere Werte ablehnt.
# Die Runner setzen sie aus -MaxCompletionTokens (0 = nicht setzen).
LLM_MAX_COMPLETION_TOKENS=
