# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
# GPTScan loads it automatically at startup (python-dotenv).
#
# Only the key for the provider you actually use is required:
#   --provider deepseek  -> DEEPSEEK_API_KEY
#   --provider openai    -> OPENAI_API_KEY

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
