# Headless image of LLMSmartAudit for use as a SmartBugs tool.
# Build (from this repo root):
#   docker build -f Dockerfile.smartbugs -t llmsmartaudit-deepseek:local .
#
# The tool reasons over Solidity SOURCE via an LLM, so NO solc / compiler is needed.
# No API key is baked in: provide DEEPSEEK_API_KEY or OPENAI_API_KEY at run time
# (SmartBugs forwards them via sb/docker.py).
FROM python:3.10-slim

WORKDIR /app

# Copy the (patched) tool source into the image.
COPY . /app

# Python deps only. requirements.txt pins httpx<0.28 (openai 1.3.3 compat).
RUN pip install --no-cache-dir -r requirements.txt

# pre_processing lists WareHouse/ at startup; ensure it exists (its contents are .dockerignored).
RUN mkdir -p /app/WareHouse

# Provider/model can be overridden per run via env (read by the SmartBugs wrapper).
ENV LLM_PROVIDER=deepseek
ENV LLM_MODEL=deepseek-chat
# Avoid UnicodeEncodeError when the tool prints emoji in its post-processing summary.
ENV PYTHONIOENCODING=utf-8

# SmartBugs overrides the entrypoint via the tool config; this is only a sane default.
ENTRYPOINT ["/bin/sh"]
